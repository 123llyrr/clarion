# Build artifacts
/target

# Nix build results
/result
/results

# Python script caches
__pycache__/
*.py[cod]

# Rust test coverage
*.profraw

# Insta snapshot review artifacts
*.pending-snap
*.snap.new

# Local diagnostic dumps (do not commit)
/crash_*.txt
/done*.txt
/vk3_*.txt
/all.txt
/t2.txt
/sandbox_out.txt
/test_out.txt

# Editors
.idea/
.vscode/

# Locally imported macOS reference assets (Apple property, never commit).
# scripts/import-macos-assets.sh writes these; the removal record lives in
# resources/licenses/removed-apple-assets.sha256.
/clarion-shell/assets/macos/*.png
/clarion-shell/assets/macos/*.pdf
/clarion-shell/assets/macos/*.svg
/clarion-shell/assets/macos/*.tiff
/clarion-shell/assets/macos/*.icns
/clarion-shell/assets/macos/*.ttf
/clarion-shell/assets/macos/*.otf
/clarion-shell/assets/macos/sources/
/clarion-settings/assets/macos/*.png

# Local Shell debug symbols
/clarion-shell/debug_info/

# Promotional media belongs in release attachments, not source snapshots
/promo/

