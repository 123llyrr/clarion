# Build artifacts
/target

# Nix build results
/result
/results

# Python script caches
__pycache__/
*.py[cod]

# Rust test coverage
*.profraw

# Insta snapshot review artifacts
*.pending-snap
*.snap.new

# Local diagnostic dumps (do not commit)
/crash_*.txt
/done*.txt
/vk3_*.txt
/all.txt
/t2.txt
/sandbox_out.txt
/test_out.txt

# Editors
.idea/
.vscode/

# Locally imported macOS reference assets (Apple property, never commit).
# scripts/import-shell-assets.sh writes these; the removal record lives in
# resources/licenses/removed-apple-assets.sha256.
/clarion-shell/assets/shell/*.png
/clarion-shell/assets/shell/*.pdf
/clarion-shell/assets/shell/*.svg
/clarion-shell/assets/shell/*.tiff
/clarion-shell/assets/shell/*.icns
/clarion-shell/assets/shell/*.ttf
/clarion-shell/assets/shell/*.otf
/clarion-shell/assets/shell/sources/
/clarion-settings/assets/shell/*.png
# The project mark is original artwork and ships with the repository.
!/clarion-shell/assets/shell/clarion-mark-white.png
!/clarion-shell/assets/shell/clarion-mark-black.png

# Local Shell debug symbols
/clarion-shell/debug_info/

# Promotional media belongs in release attachments, not source snapshots
/promo/

